{
  "name": "McLay Swimming OS Version 1.5 Workflow & Evidence",
  "short_name": "McLay Swim 1.5",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef4f7",
  "theme_color": "#123a5b",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share-title",
      "text": "share-text",
      "url": "share-url"
    }
  }
}